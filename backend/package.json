{
  "name": "healthy-challenge-backend",
  "version": "1.0.0",
  "description": "backend do healthy challenge web",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/models/desafioModel.js",
      "src/services/desafioService.js",
      "src/controllers/desafioController.js",
      "src/routes/desafioRoutes.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.4.1",
    "babel-plugin-istanbul": "^8.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "js-yaml": "^4.1.2"
  }
}
